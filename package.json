{
  "name": "goffamartin-presentation-web",
  "private": true,
  "scripts": {
    "build": "node scripts/build-html.js && tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify && node scripts/cache-bust.js",
    "build:css": "npm run build",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "copy:vendor": "node scripts/copy-vendor.js && node scripts/cache-bust.js",
    "indexnow": "node scripts/indexnow.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "tailwindcss": "3.4.17"
  }
}
